# Copy this file to `.env.wamp` and fill in credentials for your existing
# WAMP WordPress + WooCommerce installation. This profile is not provisioned
# or changed by Docker commands.
#
# Run only REST API tests against WAMP, for example:
#   API_ENV=local pytest tests/customers/api tests/orders/api tests/products/api tests/coupons/api
# GraphQL and UI tests are currently supported only by the Docker/CI profiles.

API_ENV=local
AUTH_TYPE=oauth1

# Existing WAMP WooCommerce REST API credentials.
WC_KEY=your_wamp_consumer_key
WC_SECRET=your_wamp_consumer_secret

# REST-only WAMP runs do not use GraphQL Application Passwords.
WP_ADMIN_USER=admin
WP_ADMIN_APP_PASSWORD=

# Existing WAMP MySQL connection. Update these to match WAMP's wp-config.php.
DB_USER=your_wamp_db_user
DB_PASSWORD=your_wamp_db_password
DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=your_wamp_wordpress_database
DB_TABLE_PREFIX=wp_
